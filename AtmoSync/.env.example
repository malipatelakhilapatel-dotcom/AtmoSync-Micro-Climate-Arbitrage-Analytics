# =====================================================================
# AtmoSync: Micro-Climate Arbitrage Analytics - Environment Configuration
# Copy this file to .env and supply actual values for your deployment.
# NEVER commit .env to version control!
# =====================================================================

# ---------------------------------------------------------------------
# Snowflake Warehouse Credentials
# ---------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=atmosync_user
SNOWFLAKE_PASSWORD=your_secure_password
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_ROLE=ATMOSYNC_ROLE

# ---------------------------------------------------------------------
# Apache Kafka Configuration
# ---------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_SENSOR_DATA=sensor-data
KAFKA_TOPIC_ALERTS=alerts
KAFKA_CONSUMER_GROUP=atmosync-snowflake-loader
KAFKA_AUTO_OFFSET_RESET=earliest

# ---------------------------------------------------------------------
# IoT Simulator Settings
# ---------------------------------------------------------------------
SIMULATOR_NUM_CONTAINERS=5
SIMULATOR_INTERVAL_SECONDS=2.0
SIMULATOR_ABNORMAL_PROBABILITY=0.35

# ---------------------------------------------------------------------
# Superset / Web Integration
# ---------------------------------------------------------------------
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# Optional Notifications (Slack / Webhook)
# ---------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_MIN_RISK_SCORE=75
