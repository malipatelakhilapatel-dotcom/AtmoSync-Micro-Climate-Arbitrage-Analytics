# ==========================================
# AtmoSync: Micro-Climate Arbitrage Analytics
# Environment Configuration Template
# ==========================================

# ------------------------------------------
# Snowflake Data Warehouse Credentials
# ------------------------------------------
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1.aws
SNOWFLAKE_USER=atmosync_svc
SNOWFLAKE_PASSWORD=YourSecurePasswordHere123!
SNOWFLAKE_ROLE=ATMOSYNC_ROLE
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_DATABASE=ATMOSYNC_DB
SNOWFLAKE_SCHEMA=RAW

# ------------------------------------------
# Apache Kafka Configuration
# ------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SENSOR_TOPIC=sensor-data
KAFKA_ALERT_TOPIC=spoilage-alerts
KAFKA_CONSUMER_GROUP=atmosync-warehouse-loader
KAFKA_AUTO_OFFSET_RESET=earliest

# ------------------------------------------
# IoT Telemetry Simulator Settings
# ------------------------------------------
SIMULATOR_NUM_CONTAINERS=10
SIMULATOR_TICK_INTERVAL_SEC=2.0
SIMULATOR_ABNORMAL_PROBABILITY=0.25
SIMULATOR_RANDOM_SEED=42

# ------------------------------------------
# Business Thresholds & Arbitrage Tuning
# ------------------------------------------
FREIGHT_COST_PER_KM_KG=0.015
SPOILAGE_RISK_ALERT_THRESHOLD=75.0
CRITICAL_TIME_TO_SPOILAGE_HOURS=12.0
